{
  "name": "pocket-khata",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-db.js && prisma generate && next dev -H 0.0.0.0",
    "build": "node scripts/prepare-db.js && prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "db:push": "node scripts/prepare-db.js && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/prepare-db.js && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.18",
    "next-auth": "5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

